# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Postgres connection string. For quick local testing without installing
# Postgres you can instead set DATABASE_URL=sqlite:///./aivoa.db
DATABASE_URL=postgresql+psycopg2://aivoa:aivoa@localhost:5432/aivoa

# Models. The assignment specifies gemma2-9b-it (extraction) and
# llama-3.3-70b-versatile (reasoning), but Groq has since decommissioned
# both. These are Groq's current recommended replacements as of this
# writing - verify against https://console.groq.com/docs/models before
# your demo, since Groq's lineup changes frequently.
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

CORS_ORIGINS=http://localhost:5173
